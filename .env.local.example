# PostgreSQL (self-hosted on your VPS, or any Postgres instance)
DATABASE_URL=postgresql://user:password@your-vps-host:5432/portafolio

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-key

# Single admin account allowed to sign in to /admin.
# `npm start` runs a schema sync + admin upsert automatically on every boot
# (see "start"/"db:deploy" in package.json) — no manual migration or seed
# step needed on first deploy. You can remove ADMIN_PASSWORD from your
# platform's env vars after the first successful login if you'd rather not
# leave it set permanently; it only re-syncs the password when present.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# Resend (email notifications)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Your Name <noreply@yourdomain.com>

# Upstash Redis (distributed rate limiting)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
